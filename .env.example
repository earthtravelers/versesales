# Copy to .env (local) or enter as Variables on Railway. Never commit your real .env.

# Where sale emails go
MAIL_TO=you@example.com

# Resend (recommended): https://resend.com -> API Keys
RESEND_API_KEY=
# Optional sender, e.g. "STUPIDS Bot <bot@yourdomain.com>" (needs a verified domain on Resend)
MAIL_FROM=

# Gmail instead of Resend (local only; Railway blocks SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Send a sample sale email ([TEST]) on start; set back to false once it arrives
TEST_MAIL=true

# Collection (defaults are STUPIDS)
CONTRACT=0x00c2d197bc6a99c916b0b6bc405c23186ede7f1b
COLLECTION_NAME=STUPIDS
# Link shown in every email
SALES_URL=https://verse.works/series/stupids-by-demon-ego/activity

# Optional
RPC_URL=https://ethereum-rpc.publicnode.com
POLL_SECONDS=60
START_BLOCK=
STATE_FILE=
